{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "sourceMap": false,
    "declaration": false,
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "test"]
}
