{
  "name": "@tae/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "taest 안드로이드·iOS 앱 (Capacitor 껍데기 + 서버 연결 화면)",
  "scripts": {
    "build": "node scripts/prepare-www.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "assets": "capacitor-assets generate --android --ios",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
