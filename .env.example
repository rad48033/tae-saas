# ── Supabase ────────────────────────────────────────────────
# Supabase 프로젝트: Dashboard > Project Settings > API
# 값을 비워 두면 두 앱 모두 인메모리 저장소(개발용)로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# (선택) Postgres 직접 연결. supabase CLI/migration 작업에 사용
DATABASE_URL=

# ── AI 텍스트 생성 (대본·블로그·SNS) ────────────────────────
# 실제 LLM 제공자를 고릅니다. 비워 두면 아래 자동 순서를 따릅니다.
#   anthropic → openai → gemini → demo(키 없음)
# 지정한 제공자의 키가 없으면 자동 순서로 돌아갑니다.
AI_PROVIDER=

# Anthropic Claude (자동 순서 1번)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI GPT 텍스트 (자동 순서 2번). 이미지·TTS 모델과 분리해서 고를 수 있습니다.
# 텍스트와 영상 미디어가 같은 OPENAI_API_KEY를 쓰고, 텍스트만 다른 모델을 쓰려면 OPENAI_TEXT_MODEL.
OPENAI_TEXT_MODEL=gpt-4o-mini

# Google Gemini (자동 순서 3번 · 무료 등급에서도 텍스트·TTS·전사가 열립니다)
# 모델 별칭을 기본값으로 둡니다. 특정 버전은 신규 사용자에게 닫힐 수 있습니다
# (예: gemini-2.5-flash → no longer available to new users).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=

# ── 영상 미디어 제공자 ───────────────────────────────────────
# auto(기본): OpenAI 키가 있으면 OpenAI, 없으면 Gemini TTS·전사 + 무료 이미지
# openai: OpenAI 미디어 강제 / gemini: Gemini 음성 강제 / free: 무료 대체만
# OpenAI 키는 있는데 크레딧이 0이면 미디어 단계가 429로 멈춥니다. 그럴 때 gemini로 지정하세요.
VIDEO_PROVIDER=auto

# ── OpenAI (AI 영상: 이미지 · TTS · Whisper STT) ──────────────
# 비워 두면 결정적 데모 이미지·음성·자막 정렬로 전체 파이프라인이 동작합니다.
# 주의: 키가 유효해도 결제 크레딧이 0이면 모든 호출이 429 insufficient_quota로 실패합니다.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# 기본 이미지 모델이 조직 인증·모델 중단으로 실패할 때 쓸 대체 모델(선택).
# dall-e-3는 OpenAI에서 더 이상 제공되지 않습니다(The model 'dall-e-3' does not exist).
OPENAI_IMAGE_FALLBACK_MODEL=
# gpt-image-1: low | medium | high (비용 절감)
OPENAI_IMAGE_QUALITY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1
# (선택) 호환 게이트웨이를 쓸 때
OPENAI_BASE_URL=

# ── Gemini 음성 (OpenAI 키가 없을 때 실제 AI 음성·자막) ───────
# GEMINI_API_KEY가 있으면 영상 음성은 Gemini TTS, 자막은 Gemini 전사로 만듭니다.
# OpenAI 키가 있으면 OpenAI 경로(이미지·TTS·Whisper)가 우선입니다.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# 프리셋 보이스: Kore | Puck | Charon | Fenrir | Aoede | Leda | Orus | Zephyr
# (OpenAI 보이스 이름을 넣어도 Gemini 보이스로 자동 매핑됩니다)
GEMINI_TTS_VOICE=
GEMINI_STT_MODEL=gemini-3.5-transcribe
# 무료 등급 분당 한도(예: 3/min)에 맞춘 요청 간격. 장면이 많으면 21000 권장
GEMINI_TTS_MIN_INTERVAL_MS=
# aligned 로 두면 자막을 전사 없이 결정적 정렬로 만듭니다(무료 전사 한도가 낮을 때)
VIDEO_STT=

# ── 영상 렌더 워커 ──────────────────────────────────────────
# Vercel은 ffmpeg 렌더를 못 돌립니다. apps/video-worker를 배포하고 URL을 넣으세요.
# 없으면 프로덕션에서는 스토리보드·자막까지만 제공합니다.
VIDEO_WORKER_URL=
VIDEO_WORKER_TOKEN=
# 로컬/상주 서버에서 Next 프로세스가 직접 렌더 (프로덕션에서는 기본 꺼짐)
VIDEO_INLINE=
VIDEO_OUTPUT_DIR=
VIDEO_SUBTITLE_FONT=Noto Sans CJK KR
# 영상 기획 1회 크레딧
VIDEO_CONVERT_COST=1
# 워커: 1이면 OPENAI_API_KEY가 있어도 데모만 사용
VIDEO_DEMO=
# 키 없을 때 대체: pollinations(무료 AI 이미지, 장면당 최대 45초) | card(직접 그린 카드)
VIDEO_DEMO_IMAGE=pollinations
# 키 없을 때 음성: google(무료 TTS, 한국어 실제 음성) | bed(배경 음)
# GEMINI_API_KEY가 있으면 이 값과 무관하게 Gemini TTS(실제 AI 음성)를 씁니다.
VIDEO_DEMO_VOICE=google
# 1이면 외부 무료 서비스를 부르지 않고 카드·배경 음으로만 렌더
VIDEO_OFFLINE=
# 무료 이미지 캐시 폴더(프롬프트 해시). 재렌더는 이 캐시를 재사용합니다
VIDEO_IMAGE_CACHE_DIR=
# ffmpeg 실행 파일 (기본: PATH의 ffmpeg, 없으면 ffmpeg-static 시도)
FFMPEG_PATH=

# ── LemonSqueezy ────────────────────────────────────────────
# Store > Products 에서 만든 각 크레딧팩의 Variant ID
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_STORE_SLUG=taest
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_SCALE=

# ── 공통 ────────────────────────────────────────────────────
# 세션 쿠키(HMAC) 서명 키. openssl rand -hex 32 로 생성
SESSION_SECRET=
# PDF API 키 발급(/v1/keys)에 쓰는 관리자 토큰
PDF_API_ADMIN_TOKEN=
# 브라우저에서 PDF API를 직접 호출할 때 허용할 Origin (쉼표 구분, 미설정 시 *)
ALLOWED_ORIGINS=

# ── 앱 URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://taest.info
NEXT_PUBLIC_BLOG_APP_URL=https://blog.taest.info
NEXT_PUBLIC_PDF_APP_URL=https://api.taest.info
