{
  "name": "tae-saas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:blog": "pnpm --filter @tae/youtube-blog dev",
    "dev:pdf": "pnpm --filter @tae/pdf-api dev",
    "dev:worker": "pnpm --filter @tae/video-worker dev",
    "video": "pnpm --filter @tae/video exec tsx src/cli.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11"
  }
}
